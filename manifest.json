{
  "manifest_version": 3,
  "name": "Persian Typo Fixer",
  "description": "اصلاح خودکار غلط‌های فارسی + هشدار معنایی میزارم/بزار — نیم‌فاصله، اعداد، نقطه‌گذاری",
  "version": "1.11.0",
  "author": "TheAzizi",
  "homepage_url": "https://github.com/TheGreatAzizi",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "activeTab", "contextMenus", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Persian Typo Fixer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["fixes.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
